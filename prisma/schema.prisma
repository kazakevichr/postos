generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("MANAGER") // OWNER | MANAGER | SMM | PARTNER
  fixedSalary  Float    @default(15000)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Телеграм: chatId появляется после привязки профиля через бота,
  // tgLinkCode — одноразовый код в ссылке t.me/...?start=<code>.
  tgChatId   String? @unique
  tgUsername String?
  tgLinkCode String? @unique

  access       ProjectAccess[]
  partners     Partner[]       @relation("ResponsibleUser")
  tasks        Task[]          @relation("AssignedUser")
  transactions Transaction[]   @relation("CreatedByUser")
  comments     Comment[]
  stageChanges StageHistory[]
  payrolls     PayrollRecord[]
}

model Project {
  id                       String   @id @default(cuid())
  name                     String
  currency                 String   @default("RUB")
  unitPrice                Float?
  partnerCommissionPercent Float    @default(50)
  ownerProfitPercent       Float    @default(50)
  kpiEnabled               Boolean  @default(true)
  kpiAmount                Float    @default(0)
  kpiTriggerStage          String   @default("Работает")
  bonusEnabled             Boolean  @default(false)
  bonusPercent             Float    @default(0)
  bonusThreshold           Float    @default(0)
  bonusMaxAmount           Float?
  bonusPeriodMonths        Int?
  partnerPlan              Int?
  funnelStages             String   @default("[\"Найдено\",\"Согласился\",\"Работает\",\"Есть продажи\",\"Неактивный\"]")
  healthGreenDays          Int      @default(7)
  healthYellowDays         Int      @default(29)
  isActive                 Boolean  @default(true)
  // Откуда тянуть поступления: superfit (лендинг с CloudPayments) или
  // oracle (подписки Оракла). Пусто — доход вносится руками.
  incomeSource             String?
  // Бренды соцсетей этого направления: по ним фильтруются Соц.Сети и
  // нейро-аналитика. Через запятую, имена — из BRAND_MAP.
  brandKeys                String   @default("")
  // Есть ли у направления свой контент-завод. Пока он один, у СуперФита:
  // у остальных разделы завода и кабинета СММ показывают пустое место,
  // а не чужие нормы.
  hasFactory               Boolean  @default(false)
  knowledgeBase            String   @default("")
  createdAt                DateTime @default(now())

  partnerTypes PartnerType[]
  partners     Partner[]

  // Деньги проекта. Связь мягкая (SetNull): проект можно закрыть, а расходы,
  // которые он успел собрать, остаются в истории месяца как общие.
  ledger    Ledger[]
  recurring RecurringCost[]
  payrolls  PayrollRecord[]
  access    ProjectAccess[]
}

// Кто на каких направлениях работает. Роль отвечает на вопрос «что человек
// делает», эта таблица — «где». Две оси вместо одной: иначе на каждое новое
// направление пришлось бы заводить новые роли.
//
// ПУСТОЙ СПИСОК У ВЛАДЕЛЬЦА ОЗНАЧАЕТ «ВСЕ». Это единственное исключение, и
// оно намеренное: владельцу не нужно раздавать себе доступы вручную и потом
// вспоминать про них, заводя новый проект.
model ProjectAccess {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  level     String   @default("work") // view | work | manage
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
}

model PartnerType {
  id        String    @id @default(cuid())
  projectId String
  name      String
  kpiAmount Float
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  partners  Partner[]
}

model Partner {
  id                String    @id @default(cuid())
  projectId         String
  partnerTypeId     String?
  name              String
  instagram         String?
  telegram          String?
  phone             String?
  responsibleUserId String
  stage             String
  status            String    @default("ACTIVE")
  firstContactDate  DateTime?
  connectedDate     DateTime?
  firstSaleDate     DateTime?
  lastSaleDate      DateTime?
  kpiPaid           Boolean   @default(false)
  lostReason        String?
  lostAt            DateTime?
  retryReminderDate DateTime?
  adCreativeUrl     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  partnerType  PartnerType?   @relation(fields: [partnerTypeId], references: [id])
  responsible  User           @relation("ResponsibleUser", fields: [responsibleUserId], references: [id])
  transactions Transaction[]
  stageHistory StageHistory[]
  tasks        Task[]
  comments     Comment[]
}

model StageHistory {
  id              String   @id @default(cuid())
  partnerId       String
  fromStage       String?
  toStage         String
  changedByUserId String
  changedAt       DateTime @default(now())

  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  changedBy User    @relation(fields: [changedByUserId], references: [id])
}

model Transaction {
  id                  String   @id @default(cuid())
  partnerId           String
  date                DateTime
  period              String   @default("day")
  revenueAmount       Float
  ownerProfitAmount   Float
  partnerPayoutAmount Float    @default(0)
  partnerPayoutPaid   Boolean  @default(false)
  note                String?
  createdByUserId     String
  createdAt           DateTime @default(now())

  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  createdBy User    @relation("CreatedByUser", fields: [createdByUserId], references: [id])
}

model Task {
  id               String    @id @default(cuid())
  assignedToUserId String
  partnerId        String?
  title            String
  dueDate          DateTime?
  isDone           Boolean   @default(false)
  isAuto           Boolean   @default(false)
  createdAt        DateTime  @default(now())
  // Задачи, выловленные ботом из чатов: откуда пришла и кто написал.
  source           String?
  sourceChat       String?
  // Цена доп задачи (п.3 договорённостей с СММ): оплачивается сверх нормы.
  price            Float?

  assignedTo User     @relation("AssignedUser", fields: [assignedToUserId], references: [id])
  partner    Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(cuid())
  partnerId String
  userId    String
  text      String
  createdAt DateTime @default(now())

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])
}

// Зарплата за месяц. Заводится руками на вкладке «Зарплата»: посчитанная
// цифра остаётся рядом подсказкой, а решение за владельцем — состав команды
// меняется, и формула поспевает не всегда (решение Романа 01.09).
// totalAmount — начислено, paidAt — когда деньги реально ушли. В расходы
// месяца запись попадает по paidAt, начисление показывается отдельно.
model PayrollRecord {
  id          String    @id @default(cuid())
  userId      String
  month       String
  fixedAmount Float     @default(0)
  kpiTotal    Float     @default(0)
  bonusTotal  Float     @default(0)
  totalAmount Float
  note        String    @default("")
  projectId   String? // пусто — человек работает на несколько направлений
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([userId, month])
}

// Журнал денег: одна запись — одно движение. Метод кассовый, поэтому дата
// здесь та, когда деньги пришли или ушли, а не когда о них договорились.
// Партнёрские продажи, зарплата и пополнения кошельков сюда не пишутся —
// у них свои таблицы, иначе месяц посчитается дважды.
model Ledger {
  id        String   @id @default(cuid())
  kind      String // in | out
  date      DateTime
  category  String // реклама | сервис | прочее | продажи
  title     String
  amount    Float
  currency  String   @default("RUB")
  note      String   @default("")
  projectId String? // пусто — расход общий, не на конкретное направление
  byUserId  String?
  // Откуда запись: «руками» или имя источника, который её принёс.
  // externalId — id платежа у источника, по нему синхронизация узнаёт своё
  // и не заводит один и тот же платёж дважды.
  source     String  @default("руками")
  externalId String?
  createdAt  DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([source, externalId])
  @@index([date])
}

// Постоянные платежи: сервер, домены, подписки. Живут с месяца и до месяца,
// чтобы смена цены не переписывала уже прошедшие периоды.
model RecurringCost {
  id        String   @id @default(cuid())
  title     String
  category  String   @default("сервис")
  amount    Float
  currency  String   @default("RUB")
  fromMonth String // YYYY-MM
  toMonth   String? // YYYY-MM, пусто — платим до сих пор
  projectId String? // пусто — платим за всё сразу: сервер, домены
  createdAt DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

// ── Инста-аналитика (перенос из insta-hq/Netlify) ───────────────────────────
// Один аккаунт Instagram = одна строка. history и media — JSON-строки:
// SQLite не умеет Json-тип, а история нужна целиком и всегда читается разом.
model IgAccount {
  igId      String   @id
  username  String
  brand     String
  profile   String   @default("{}")
  history   String   @default("[]")
  media     String   @default("[]")
  updatedAt DateTime @updatedAt
}

// Временный публичный хостинг картинок для публикации каруселей:
// Graph API принимает изображения только по публичному URL. Instagram
// забирает копию себе, наша живёт три дня и подчищается при загрузках.
model HostedImage {
  id        String   @id
  mime      String   @default("image/png")
  data      Bytes
  createdAt DateTime @default(now())
}

// ── Аналитика Оракла: YouTube-каналы (свои OAuth-токены завода) и TikTok
// (через upload-post Analytics). Паттерн тот же, что у IgAccount.
model OracleChannel {
  id        String   @id @default(cuid())
  platform  String // yt | tiktok
  key       String // язык канала (ru/en/...) или профиль upload-post
  profile   String   @default("{}")
  history   String   @default("[]")
  media     String   @default("[]")
  updatedAt DateTime @updatedAt

  @@unique([platform, key])
}

// ── Контент-завод: план тем и журнал производства ──────────────────────────
// Контракт с заводом (content_converter/auto/planhub.py): GET /api/factory/plan
// отдаёт тему дня по слоту, POST /api/factory/log принимает события заказа.
model PlanSlot {
  id    String @id @default(cuid())
  // Чей это план. Заводов больше одного: СуперФит и Оракл — разные проекты
  // с разными темами, и без бренда их клетки затирали бы друг друга (ключ
  // «дата+слот» у обоих одинаковый). Дефолт — СуперФит: всё, что накоплено
  // до появления второго завода, его.
  brand String @default("superfit")
  date  String // YYYY-MM-DD
  slot  String // make | carousel | trainer:male | trainer:female | avatar
  topic String @default("")
  facts String @default("")

  @@unique([brand, date, slot])
}

model FactoryJob {
  jobId     String   @id
  // Какой завод отчитался. Заказы двух заводов лежат в одной таблице, и без
  // этого поля Оракл видел бы производство СуперФита, а СуперФит — Оракла.
  brand     String   @default("superfit")
  date      String   @default("")
  slot      String   @default("")
  kind      String   @default("")
  character String   @default("")
  topic     String   @default("")
  script    String   @default("")
  event     String   @default("") // создан | готов | опубликован | не принят | ошибка
  links     String   @default("[]")
  error     String   @default("")
  onDemand  Boolean  @default(false)
  cost      Float    @default(0) // смета заказа в долларах (событие «готов»)
  seconds   Int      @default(0) // длительность производства (событие «готов»)
  at        DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Брак, поставленный из Postos постфактум (кнопка в журнале). Отдельная
// таблица с монотонным id — завод забирает новые пометки курсором
// GET /api/factory/defects?after=<id>. Брак из бота сюда НЕ пишется
// (он приходит событием через /api/factory/log), иначе завод получит
// свои же пометки обратно.
model FactoryDefect {
  id      Int      @id @default(autoincrement())
  jobId   String
  comment String   @default("")
  at      DateTime @default(now())
}

// Нейро-аналитика контента: сохранённые разборы «что заходит / что не
// заходит» по срезу (платформа|проект|профиль|период). Храним, чтобы не
// звать модель при каждом открытии страницы.
model SocialInsight {
  scope     String   @id
  result    String   @default("{}")
  updatedAt DateTime @updatedAt
}

// Заявка на доступ из Телеграма: сотрудник написал боту /start, ждёт
// одобрения владельца. Одобрить может только владелец — из бота или из
// раздела «Сотрудники».
model TgSignup {
  id        String   @id @default(cuid())
  chatId    String   @unique
  username  String?
  name      String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

// Что уже перезалито из Instagram на другие площадки — чтобы не публиковать
// один и тот же ролик дважды. Пишет завод после успешной публикации.
model MirrorLog {
  id        Int      @id @default(autoincrement())
  platform  String
  permalink String
  link      String   @default("")
  at        DateTime @default(now())

  @@unique([platform, permalink])
}

// Маршруты публикации: что и куда уходит. Источник правды для завода и
// зеркалирования — выключенное не публикуется ни автопланом, ни кнопкой.
// kind="*" — рубильник площадки целиком.
model RouteFlag {
  id       Int      @id @default(autoincrement())
  platform String
  kind     String
  enabled  Boolean  @default(true)
  at       DateTime @updatedAt

  @@unique([platform, kind])
}

// Мелкие служебные отметки, которые должны переживать перезапуск контейнера:
// например, какого числа уже отправлены утренние напоминания по задачам.
model Setting {
  key   String   @id
  value String
  at    DateTime @updatedAt
}

// Паспорт контента: разметка поста по осям для нейро-аналитики.
// Заводские посты размечает сам завод (labeledBy=factory), ручные —
// нейросеть по описанию (labeledBy=ai).
model ContentMeta {
  key       String    @id // нормализованный permalink без протокола
  platform  String    @default("instagram")
  source    String    @default("manual") // factory | manual
  format    String    @default("") // видео | карусель | фото
  origin    String    @default("") // персонаж | карусель завода | тренер Ж | ИИ-аватар | тренер М | нарезка | ручной
  topic     String    @default("")
  hook      String    @default("") // вопрос | боль | цифра | до-после | интрига | нет
  content   String    @default("") // практика | анонс | лайфстайл | продажа
  cta       String    @default("") // кодовое слово | ссылка | подписка | нет
  visual    String    @default("") // что в кадре: тренировка в зале | говорит в камеру | еда | ...
  ctaVideo  String    @default("") // призыв внутри ролика: кодовое слово | подписка | ссылка | нет
  ctaWord   String    @default("") // само кодовое слово, если есть
  leads     Int       @default(-1) // заявки: комментарии с кодовым словом (-1 — не считали)
  leadsAt   DateTime?
  labeledBy String    @default("") // factory | ai
  at        DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Рекомендация нейро-аналитики: живёт между анализами, чтобы отслеживать
// судьбу (внедрена ли) и не советовать одно и то же по кругу.
model Recommendation {
  id        String    @id @default(cuid())
  scope     String    @default("")
  text      String
  norm      String    @unique // нормализованный текст для дедупа
  status    String    @default("new") // new | task | done | dismissed
  taskId    String    @default("")
  effect    String    @default("")
  createdAt DateTime  @default(now())
  doneAt    DateTime?
}

// Кошелёк платного сервиса завода. Первого сентября 2026 производство встало
// на четыре дня: на роутере кончились деньги, а узнать об этом было неоткуда —
// завод сообщал, что виновата тема. Раздел «Кошельки» закрывает именно это.
//
// Две половины в одной строке, и это намеренно. Что сервис отдаёт по API,
// присылает завод раз в час (ok/left/spent). Чего сервис не отдаёт —
// вносит человек (manual, пополнения ниже). Остаток роутера, OpenAI и fal
// по API не читается вовсе: у роутера есть только «потрачено всего», у
// OpenAI и fal нет и этого. Поэтому «сколько осталось» = пополнения − расход,
// и без ручного ввода эта цифра не появится ниоткуда.
model Wallet {
  service   String    @id // router | openai | eleven | heygen | fal
  // Кошелёк, заведённый руками, живёт целиком здесь: справочник в коде знает
  // только те сервисы, что подключены к сбору замеров, а платят люди и за то,
  // чего в нём нет. Пустой project означает «спроси справочник» — так строки,
  // накопленные до появления ручных кошельков, остаются на своих местах.
  project   String    @default("")
  custom    Boolean   @default(false) // заведён руками — можно удалить
  // Сервисом больше не пользуются. Не удаление: замеры по нему могут
  // приходить и дальше, а история пополнений остаётся — просто он уходит из
  // рабочего списка и перестаёт поднимать тревогу. Справочный кошелёк иначе
  // и не убрать: удалить его нельзя, он вернётся со следующим замером.
  inactive  Boolean   @default(false)
  blocks    Boolean   @default(false) // пустой кошелёк останавливает работу
  title     String    @default("")
  ok        Boolean   @default(true) // можно ли платить прямо сейчас
  low       Boolean   @default(false) // на исходе
  left      Float? // остаток, если сервис его отдаёт
  unit      String    @default("") // в чём остаток: $, секунды, символы
  spent     Float? // потрачено всего, если сервис считает
  note      String    @default("") // человеческая причина
  link      String    @default("") // кабинет: зайти и проверить руками
  manual    Float? // остаток, вписанный человеком
  manualAt  DateTime?
  state     String    @default("") // ok | low | down — чтобы пушить на СМЕНУ
  at        DateTime? // когда завод присылал замер
  updatedAt DateTime  @updatedAt
}

// Пополнение: когда, сколько и кто. Отсюда считается остаток тех сервисов,
// которые его не отдают. Отдельной таблицей, а не полем: важна история —
// «когда пополнял и сколько» человек спрашивает чаще, чем текущий остаток.
model WalletTopup {
  id      Int      @id @default(autoincrement())
  service String
  amount  Float // в долларах
  at      DateTime @default(now())
  who     String   @default("")
  note    String   @default("")

  @@index([service, at])
}
